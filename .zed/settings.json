{
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp", "!solargraph", "!rubocop"],
      "formatter": "language_server",
      "format_on_save": "on"
    },

    "TypeScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "indent_guides": {
        "background_coloring": "indent_aware"
      }
    }
  },

  "lsp": {
    "ruby-lsp": {
      "initialization_options": {
        "formatter": "rubocop",
        "linters": ["rubocop"],
        "enabledFeatures": {
          "formatting": true
        }
      }
    }
  }
}
